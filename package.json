{
  "name": "opencode-webhook-notifier",
  "version": "2.0.0",
  "description": "OpenCode plugin that sends webhook notifications (Discord, ntfy, Gotify) on permission, completion, and error events",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "webhook",
    "discord",
    "ntfy",
    "gotify",
    "notifications"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@opencode-ai/plugin": "^1.0.224",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.22.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  }
}
