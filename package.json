{
  "name": "opencode-webhook-notifier",
  "version": "2.1.0",
  "description": "OpenCode plugin that sends webhook notifications (Discord, ntfy, Gotify, Telegram, generic HTTP) on permission, completion, error, and other events",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "webhook",
    "discord",
    "ntfy",
    "gotify",
    "telegram",
    "notifications"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@opencode-ai/plugin": "^1.0.224",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.22.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
